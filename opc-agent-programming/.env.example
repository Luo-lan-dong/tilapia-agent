# 运行环境：local/dev/staging/prod（影响日志格式：local 可读文本，其他 JSON）
APP_ENV=local

# 日志级别：DEBUG/INFO/WARNING/ERROR/CRITICAL
LOG_LEVEL=INFO

# OPC 中枢地址（安装脚本会自动注入）
HUB_API_URL=http://localhost:8000

# 显式指定 WebSocket 地址；留空时由 HUB_API_URL 推导
# HUB_WS_URL=ws://localhost:8000/api/v1/agent-nodes/ws

# 注册 Token（安装脚本从 --token 参数注入）
AGENT_REGISTRATION_TOKEN=your-registration-token

# 节点身份（可选，留空则自动生成）
# AGENT_CLIENT_ID=agent-programming-001
# AGENT_NAME=my-programming-node

# 心跳间隔（秒）
HEARTBEAT_INTERVAL_SECONDS=5

# 断线重连重试间隔（秒）：断线后不退出进程，按此间隔重试注册与连接（ADR-020）
RECONNECT_INTERVAL_SECONDS=5

# Agent 类型
AGENT_TYPE=code

# 任务执行超时（秒）
TASK_EXECUTION_TIMEOUT_SECONDS=300

# 工作目录
WORKSPACE_ROOT=/workspace

# 共享存储配置（可选，用于交付物上传）
# STORAGE_ENDPOINT=http://minio:9000
# STORAGE_BUCKET=opc-deliverables

# tilacode 编程执行层配置（ADR-013）
TILACODE_BINARY_PATH=/opt/opc-agent-programming/bin/tilacode
TILACODE_PORT=4096
TILACODE_HOST=127.0.0.1
TILACODE_WORKSPACE_ROOT=/opt/opc-agent-programming/workspace
TILACODE_HEALTH_CHECK_INTERVAL=30
TILACODE_AUTO_RESTART=true

# 完成判定静默期（秒）：step.ended 后无新 step.started 即判定完成
TILACODE_STEP_IDLE_TIMEOUT_SECONDS=30

# 节点并发与资源自评阈值（ADR-032）
AGENT_MAX_CONCURRENT_TASKS=2
AGENT_BUSY_CPU_THRESHOLD_PERCENT=90
AGENT_BUSY_MEM_THRESHOLD_PERCENT=90

# 通知 API（ADR-035 中枢重启主动反连）：安装脚本自动生成 API_TOKEN 并落盘
AGENT_API_HOST=0.0.0.0
AGENT_API_PORT=18080
# API_TOKEN=your-notify-api-token
