# 办公 Agent 节点配置模板（ADR-062）
# 安装脚本会自动生成 .env；本文件作为手工部署参考

# 中枢地址（安装脚本根据中枢 IP 自动注入）
HUB_API_URL=http://192.168.101.101:8000

# 节点身份
AGENT_REGISTRATION_TOKEN=xxx
AGENT_CLIENT_ID=agent-office-001
AGENT_TYPE=office

# 心跳
HEARTBEAT_INTERVAL_SECONDS=5

# 工作目录根（任务产物默认落盘位置；中枢派发带 output_dir 时优先）
WORKSPACE_ROOT=/opt/opc-agent-office/workspace

# 办公执行器（工具循环）
OFFICE_LLM_MAX_ROUNDS=30
OFFICE_LLM_TIMEOUT_SECONDS=120
OFFICE_LLM_MAX_RETRIES=2
OFFICE_LLM_TOKEN_BUDGET=200000
# token 预算软阈值比例（ADR-065 M7，默认 0.8）：达 80% 注入收尾纪律并上报，
# 达 100% 硬停并上报明确失败原因
OFFICE_LLM_BUDGET_SOFT_RATIO=0.8
OFFICE_WEB_SEARCH_MAX_RESULTS=8
OFFICE_FETCH_TIMEOUT_SECONDS=45

# 联网通道
OFFICE_SEARCH_BACKEND=auto
# web_fetch 隐身浏览器通道（ADR-065 M6）：默认关闭；SPA/强反爬站点需渲染时置 true
# （要求已安装 Patchright 浏览器，会额外占用磁盘与耗时）
OFFICE_ENABLE_STEALTH=false

# 通知 API（ADR-035，与编程节点 18080 错开）
AGENT_API_PORT=18081
API_TOKEN=xxx
