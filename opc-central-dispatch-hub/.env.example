# 应用基础配置
# APP_ENV 与 ENVIRONMENT 等价，任选其一
APP_ENV=local
APP_NAME=opc-central-dispatch-hub
DEBUG=true
LOG_LEVEL=DEBUG
LOG_DIR=./logs

# 后端服务
HOST=0.0.0.0
PORT=8000
WORKERS=1
# 中枢公网地址（Agent 安装命令使用）；留空则从请求头自动推导
HUB_PUBLIC_URL=

# 数据库
DATABASE_URL=postgresql+asyncpg://opc:opc@localhost:5432/opc
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
STORAGE_ENDPOINT=minio.opc.local:9000
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_BUCKET=opc-bucket
STORAGE_USE_SSL=true

# 安全
SECRET_KEY=change-me-in-production
AGENT_REGISTRATION_TOKEN=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 任务调度
# running 任务超过该秒数无任何进度更新即自动标 failed 并释放节点
# 最小 60（防止误配为 0）；默认 1800（30 分钟）
# （见 ADR-015 / spec/task-stale-detector-spec.md）
STALE_TASK_TIMEOUT_SECONDS=1800

# 节点心跳监控：心跳扫描间隔与离线判定超时（秒）；默认 10 / 30
HEARTBEAT_INTERVAL_SECONDS=10
HEARTBEAT_TIMEOUT_SECONDS=30

# 中枢重启主动反连（ADR-035）：对 offline 且有自报地址的节点通知新中枢地址
# notify 调用并发上限；默认 5
REVERSE_NOTIFY_CONCURRENCY=5
# 单次 notify HTTP 超时（秒）；默认 5
REVERSE_NOTIFY_TIMEOUT_SECONDS=5

# 任务调度器扫描周期（秒）；默认 10
SCHEDULER_INTERVAL_SECONDS=10

# AI 智能调度（ADR-033）
# 自动调度 AI 决策总开关；默认 false 保持纯规则（运行期以系统设置页为准）
AI_DISPATCH_ENABLED=false
# 批量决策 LLM 调用超时预算（秒），超时回退规则分配不重试；默认 8
AI_DISPATCH_TIMEOUT_SECONDS=8
# 对话 Agent 单次回复最大技能调用轮数（ADR-058：可调安全网，非唯一防线）；默认 40
# 旧默认 8 已实测误杀正常长任务（部署类侦察阶段就吃掉 6+ 轮）；真正防打转靠
# Doom Loop 检测（ADR-043）与「无新信息」进度检测
ORCHESTRATOR_MAX_TOOL_ROUNDS=40
# 连续 N 轮未引入新技能结果即判定原地打转并收尾（ADR-058 D2）；默认 4
ORCHESTRATOR_NO_PROGRESS_ROUNDS=4
# 逼近轮数上限的警示比例（ADR-058 D3）：0.75 表示用到 75% 时提示一次；默认 0.75
ORCHESTRATOR_ROUNDS_WARNING_RATIO=0.75

# 慢请求告警阈值（毫秒），超过则日志升级为 WARNING；默认 1000
SLOW_REQUEST_THRESHOLD_MS=1000

# 日志系统（ADR-047）
# 内存环形缓冲条数（查询 API 直读，重启清空）；默认 5000
LOG_RING_BUFFER_SIZE=5000
# 执行链路事件表保留天数（调度器每日清理超期行）；默认 90
TOOL_CALL_LOG_RETENTION_DAYS=90
# 节点日志按需拉取等待超时（秒）；默认 45
AGENT_LOG_FETCH_TIMEOUT_SECONDS=45
# 节点日志拉取行数上限；默认 2000
AGENT_LOG_FETCH_MAX_LINES=2000

# Agent 资源云端同步（ADR-022）
# 本地缓存目录（桌面模式由 launcher 注入绝对路径）
RESOURCE_CACHE_DIR=./data/resources
# 云端检查间隔（秒）；0=禁用定时检查；默认 21600（6 小时）
RESOURCE_SYNC_INTERVAL_SECONDS=21600
# 云端仓库默认 manifest URL（数据库未配置时的内置兜底；后台保存空值=恢复此默认）
# 默认指向作者维护的官方更新源（公共只读、不含凭据），开箱即用可拉取更新日志与节点资源；
# 自建云端资源仓库时改为自己的 manifest 地址，留空恢复代码内置默认
AGENT_RESOURCE_MANIFEST_URL=https://tilapia-web-1328924353.cos.ap-chengdu.myqcloud.com/code-agent/


# 服务端配置下发（ADR-025）：检查更新前先从此接口获取最新仓库地址（失败回退缓存）。
# 默认指向本地开发环境（云端资源仓库与中枢同机）；正式打包 exe 前必须手动改为生产服务器地址。
# 以下两条不需要可以注释掉
AGENT_RESOURCE_HUB_CONFIG_URL=https://tilahub.cn/prod-api/portal/open/hub/config
# 对接 Token（在管理后台「云端资源 → COS 配置」生成；为空=跳过下发直接用缓存/本地地址）
AGENT_RESOURCE_HUB_TOKEN=0169082a8bf24e3c9e0f78f7a0b07f71a84d2b7eac124a0981955379b42bce89


# 大模型初始配置（仅首次初始化数据库记录时使用，运行期从数据库读取）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# ADR-056：推荐模型名（旧名 deepseek-v4-flash 已退役）
DEEPSEEK_MODEL=deepseek-flash

# LLM 调用参数（ADR-056）
# 输出上限默认档：官方 MAX OUTPUT 384K；旧硬编码 8192 已实测触顶
LLM_MAX_OUTPUT_TOKENS=32768
# 思考强度：官方支持 low/high/max（medium 会被映射为 high，故不提供）
LLM_REASONING_EFFORT=high
# 编排链路思考开关：开启时按官方要求回传历史 reasoning_content
ORCHESTRATOR_THINKING_ENABLED=true



